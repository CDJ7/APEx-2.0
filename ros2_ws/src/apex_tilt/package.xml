<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apex_tilt</name>
  <version>0.1.0</version>
  <description>APEx 2.0 tilting return tray on the TurtleBot 4: a motor turns the tray from flat into a ramp so damaged parts slide into the return bin by the FlexBase.</description>
  <maintainer email="apex@example.com">APEx Systems team</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>apex_interfaces</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
