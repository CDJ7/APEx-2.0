<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apex_orchestrator</name>
  <version>0.1.0</version>
  <description>APEx 2.0 job orchestrator: job state machine, two-direction loop routing, Nav2/TurtleBot 4 adapter.</description>
  <maintainer email="apex@example.com">APEx Systems team</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>turtlebot4_navigation</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>apex_interfaces</exec_depend>
  <exec_depend>apex_plc_bridge</exec_depend>
  <exec_depend>apex_bringup</exec_depend>
  <exec_depend>apex_cell_sim</exec_depend>
  <exec_depend>apex_tilt</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
