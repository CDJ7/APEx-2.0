<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apex_rl</name>
  <version>0.1.0</version>
  <description>APEx 2.0 Learning-Based Navigation: a fast 2D training environment built from lab.yaml (Gymnasium), a baseline driver, evaluation and PPO training.</description>
  <maintainer email="apex@example.com">APEx Systems team</maintainer>
  <license>MIT</license>
  <exec_depend>apex_bringup</exec_depend>
  <exec_depend>apex_orchestrator</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- pip (not in apt): gymnasium; for training also stable-baselines3 + torch (apex_rl/requirements.txt) -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
